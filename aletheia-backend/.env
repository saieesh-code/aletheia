# Copy to .env — never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aletheia:password@localhost:5432/aletheia
JWT_SECRET=change-me-min-32-chars-random-value

# ── Optional (defaults to ephemeral dev key if absent) ────────────────────────
SERVER_SIGNING_KEY=

# ── Tuning ────────────────────────────────────────────────────────────────────
PORT=8080
RUST_LOG=aletheia_server=debug,tower_http=info
